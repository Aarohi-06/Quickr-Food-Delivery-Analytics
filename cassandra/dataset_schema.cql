-- Additive CSV storage only. Requires the existing quickr_bda keyspace.
-- Quoted names preserve exact CSV headers. Row numbers are 1-based CSV record positions.

CREATE TABLE IF NOT EXISTS quickr_bda.original_delivery_records (
    source_row_number bigint PRIMARY KEY,
    "ID" text,
    "Delivery_person_ID" text,
    "Delivery_person_Age" int,
    "Delivery_person_Ratings" double,
    "Restaurant_latitude" double,
    "Restaurant_longitude" double,
    "Delivery_location_latitude" double,
    "Delivery_location_longitude" double,
    "Order_Date" text,
    "Time_Orderd" text,
    "Time_Order_picked" text,
    "Weatherconditions" text,
    "Road_traffic_density" text,
    "Vehicle_condition" int,
    "Type_of_order" text,
    "Type_of_vehicle" text,
    "multiple_deliveries" int,
    "Festival" text,
    "City" text,
    "Time_taken(min)" text
);

CREATE TABLE IF NOT EXISTS quickr_bda.cleaned_delivery_records (
    source_row_number bigint PRIMARY KEY,
    "order_id" text,
    "delivery_person_id" text,
    "delivery_person_age" int,
    "delivery_person_rating" double,
    "restaurant_latitude" double,
    "restaurant_longitude" double,
    "delivery_latitude" double,
    "delivery_longitude" double,
    "order_date" date,
    "order_time" text,
    "pickup_time" text,
    "weather" text,
    "traffic" text,
    "vehicle_condition" int,
    "order_type" text,
    "vehicle_type" text,
    "multiple_deliveries" int,
    "festival" text,
    "city" text,
    "duration_min" double,
    "delivery_person_age_invalid" int,
    "delivery_person_rating_invalid" int,
    "multiple_deliveries_invalid" int,
    "vehicle_condition_invalid" int,
    "age_review_flag" int,
    "order_hour" int,
    "pickup_hour" int,
    "order_day_of_week" int,
    "order_month" int,
    "distance_km" double,
    "delivery_person_age_missing" int,
    "delivery_person_rating_missing" int,
    "multiple_deliveries_missing" int,
    "vehicle_condition_missing" int,
    "order_date_missing" int,
    "order_time_missing" int,
    "pickup_time_missing" int
);
